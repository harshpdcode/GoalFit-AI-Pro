# GoalFit-AI Pro Environment Variables Template
# Copy this file to .env for local development or configure these variables in Render Dashboard

# Flask Configuration
SECRET_KEY=your_super_secret_random_key_here
FLASK_DEBUG=True
PORT=5000

# Database Configuration (MySQL)
# Option A: Single Connection String
# DATABASE_URL=mysql://user:password@host:3306/goalfit_ai

# Option B: Individual Connection Parameters
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=hmpandya528@
DB_NAME=goalfit_ai
DB_PORT=3306

# Optional: Cloud Database SSL Configuration (if required by host)
# DB_SSL_CA=/path/to/ca-certificate.crt

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
